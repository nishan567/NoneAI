<?xml version="1.0" encoding="utf-8"?>
<!--
  Nonea's accessibility service. It is only active after the user turns it on in Android Settings > Accessibility.
  - canRetrieveWindowContent: lets Nonea find a button by its label on the current screen (never sent to Gemini).
  - canPerformGestures: lets Nonea tap or swipe when the user asks.
  - flagReportViewIds: lets Nonea recognise ad views so it can refuse to tap them.
  Only window-change events are observed (to remember which app you were in).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:description="@string/a11y_desc"
    android:notificationTimeout="100" />
